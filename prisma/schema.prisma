generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Member {
  id                    String            @id @default(cuid())
  nameAmharic           String
  nameEnglishFirst      String            @default("")
  nameEnglishLast       String            @default("")
  displayPreference     DisplayPreference @default(AMHARIC)
  phone                 String?
  weeklyAmount          Int
  wheelNumber           Int
  extraWheelNumber      Int?
  isArchived            Boolean           @default(false)
  archivedAt            DateTime?
  archivedReason        String?
  wheelSuspended        Boolean           @default(false)
  token                 String            @unique @default(uuid())
  confirmedAt           DateTime?
  confirmedIp           String?
  collectionConfirmedAt             DateTime?
  collectionConfirmedIp             String?
  collectionConfirmedAtExtra        DateTime?
  collectionConfirmedIpExtra        String?
  confirmedFingerprint              Json?
  collectionConfirmedFingerprint    Json?
  collectionConfirmedFingerprintExtra Json?
  pin                               String?   // bcrypt hash of 4-digit PIN
  pinAttempts                       Int       @default(0)
  pinLockedUntil                    DateTime?
  createdAt                         DateTime          @default(now())
  payments              Payment[]
  reviewRequests        PaymentReviewRequest[]
  sessions              MemberSession[]

  @@map("members")
}

model Week {
  id                String           @id @default(cuid())
  weekNumber        Int              @unique
  date              DateTime
  isSkipped         Boolean          @default(false)
  notes             String?
  winnerWheelNumber Int?
  payoutStatus      PayoutStatus?
  payoutMethod      CollectionMethod?
  payoutNotes       String?
  payments          Payment[]
  reviewRequests    PaymentReviewRequest[]

  @@map("weeks")
}

model Payment {
  id        String         @id @default(cuid())
  memberId  String
  weekId    String
  status    PaymentStatus  @default(PENDING)
  method    PaymentMethod?
  paidAt    DateTime?
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  week      Week           @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([memberId, weekId])
  @@map("payments")
}

model PaymentReviewRequest {
  id            String       @id @default(cuid())
  memberId      String
  weekId        String
  claimedStatus String
  claimedDate   DateTime
  notes         String?
  adminNote     String?
  status        ReviewStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  member        Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  week          Week         @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@map("payment_review_requests")
}

model EqubArchive {
  id          String   @id @default(cuid())
  cycleNumber Int
  startDate   DateTime
  endDate     DateTime
  archivedAt  DateTime @default(now())
  snapshot    Json

  @@map("equb_archives")
}

model MemberSession {
  id                String   @id @default(cuid())
  memberId          String
  sessionToken      String   @unique @default(uuid())
  deviceFingerprint String
  createdAt         DateTime @default(now())
  lastActiveAt      DateTime @default(now())
  expiresAt         DateTime
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_sessions")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

enum DisplayPreference {
  AMHARIC
  ENGLISH
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  DEFERRED
}

enum PaymentMethod {
  CASH
  ZELLE
  OTHER
}

enum PayoutStatus {
  PENDING
  COLLECTED
}

enum CollectionMethod {
  CASH
  ZELLE
  BOTH
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
